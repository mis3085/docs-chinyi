        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%83%9c%e3%83%88%e3%83%ab%e3%82%ad%e3%83%a3%e3%83%83%e3%83%94%e3%83%b3%e3%82%b0%e3%83%8b%e3%83%bc%e3%82%ba%e3%81%ab%e5%af%be%e5%bf%9c%e3%81%99%e3%82%8b%e5%a4%9a%e7%94%a8%e9%80%94%e3%83%99%e3%83%b3%e3%83%81%e3%83%88%e3%83%83%e3%83%97%e3%82%bd%e3%83%aa%e3%83%a5%e3%83%bc%e3%82%b7%e3%83%a7%e3%83%b3&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
