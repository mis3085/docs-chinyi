    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%a0%9c%ec%95%bd-%ea%b8%b0%ea%b3%84%ec%9d%98-%ec%9c%a0%ec%82%b0%ea%b3%bc-%ed%98%81%ec%8b%a0&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
