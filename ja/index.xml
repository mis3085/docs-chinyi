        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%83%96%e3%83%aa%e3%82%b9%e3%82%bf%e3%83%bc%e5%8c%85%e8%a3%85%e3%83%8b%e3%83%bc%e3%82%ba%e3%81%ab%e5%af%be%e3%81%99%e3%82%8b%e9%9d%a9%e6%96%b0%e7%9a%84%e3%82%bd%e3%83%aa%e3%83%a5%e3%83%bc%e3%82%b7%e3%83%a7%e3%83%b3&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
