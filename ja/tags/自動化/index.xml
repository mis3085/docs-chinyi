      <description>&lt;h2 class=&#34;relative group&#34;&gt;コンパクトな生産スペース向け効率的なカートニングソリューション 
    &lt;div id=&#34;コンパクトな生産スペース向け効率的なカートニングソリューション&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%82%b3%e3%83%b3%e3%83%91%e3%82%af%e3%83%88%e3%81%aa%e7%94%9f%e7%94%a3%e3%82%b9%e3%83%9a%e3%83%bc%e3%82%b9%e5%90%91%e3%81%91%e5%8a%b9%e7%8e%87%e7%9a%84%e3%81%aa%e3%82%ab%e3%83%bc%e3%83%88%e3%83%8b%e3%83%b3%e3%82%b0%e3%82%bd%e3%83%aa%e3%83%a5%e3%83%bc%e3%82%b7%e3%83%a7%e3%83%b3&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
